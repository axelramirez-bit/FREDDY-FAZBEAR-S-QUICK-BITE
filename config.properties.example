# Copia este archivo como config.properties (en src/) y pon tus propios
# datos. config.properties NO debe subirse a Git (ver .gitignore).
db.host=localhost
db.port=3306
db.name=FreddyQuickBite
db.user=freddy_app
db.password=

app.name=Freddy Fazbear's Quick Bite
app.version=1.0.0
app.empresa=Freddy Fazbear's Quick Bite

ui.theme=light
ui.language=es
ui.fullscreen=false

log.level=INFO

# Envío de factura por correo (OPCIONAL). Si se deja vacío o se omite,
# el pedido y el PDF se generan igual; solo se salta el envío del
# correo (ver GeneradorFacturaPdf.enviarPorCorreo, es "best-effort").
# mail.correo debe ser una cuenta de Gmail real, y mail.password debe
# ser una "contraseña de aplicación" de esa cuenta (no la contraseña
# normal; se genera en la configuración de seguridad de Google y
# requiere tener activada la verificación en dos pasos).
mail.correo=
mail.password=
